<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.autonavi.minimap" />
        <package android:name="com.baidu.BaiduMap" />
        <package android:name="com.tencent.map" />
        <package android:name="com.google.android.apps.maps" />
    </queries>

    <application>

        <activity
            android:name="com.senk.gallery.ui.AlbumDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Gallery" />

        <activity
            android:name="com.senk.gallery.ui.ViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Gallery.Viewer" />

        <activity
            android:name="com.senk.gallery.ui.VideoPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Gallery" />

        <activity
            android:name="com.senk.gallery.ui.PhotoMapActivity"
            android:exported="false"
            android:theme="@style/Theme.Gallery" />

        <!-- 最近删除：系统回收站内容，恢复/彻底删除需系统确认，页面随入口隐藏。 -->
        <activity
            android:name="com.senk.gallery.ui.RecentlyDeletedActivity"
            android:exported="false"
            android:theme="@style/Theme.Gallery" />

        <!--
          选图页：外部调用路由（main 的 ExternalEntryActivity）与内部复用共用；
          旋转时保留已选集合与数据，不重建（本页是临时任务页，重建收益低）。
        -->
        <activity
            android:name="com.senk.gallery.ui.picker.ImagePickerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Gallery" />

        <!-- 「添加到」目标相册选择页：与选图页是两个不同页面（选目标而非选照片）。 -->
        <activity
            android:name="com.senk.gallery.ui.addto.AddToAlbumActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden"
            android:exported="false"
            android:theme="@style/Theme.Gallery" />

    </application>

</manifest>
