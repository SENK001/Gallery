<?xml version="1.0" encoding="utf-8"?>
<!--
  多选按钮图标：线性描边（无填充）复选框 + 对勾。

  自绘几何（不复制上游 Material 路径，见 THIRD_PARTY_NOTICES.md）：用 stroke 而不是 fill，
  保证在主题底色上始终是「线性 / 无填充」外观；图标仍可被 Toolbar 的 iconTintList 整体着色，
  深色模式与上划 chrome 的明暗切换照常生效。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 圆角方框：24 视口内为 15×15 正方形（4.5→19.5），描边 1.8dp、内部透明；曾误画成 15×17 偏窄 -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M6,4.5 H18 A1.5,1.5 0 0 1 19.5,6 V18 A1.5,1.5 0 0 1 18,19.5 H6 A1.5,1.5 0 0 1 4.5,18 V6 A1.5,1.5 0 0 1 6,4.5 Z"
        android:strokeColor="@color/gallery_icon_on_surface"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />

    <!-- 对勾：两段折线，圆头线帽 -->
    <path
        android:fillColor="@android:color/transparent"
        android:pathData="M8,12.2 L10.8,15 L16,9.4"
        android:strokeColor="@color/gallery_icon_on_surface"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:strokeWidth="1.8" />

</vector>
