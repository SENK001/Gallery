<?xml version="1.0" encoding="utf-8"?>
<!--
  「添加到」目标选择页（AddToAlbumActivity）。

  结构（自上而下）：
    · addto_toolbar —— 返回 + 标题「添加到」
    · addto_list    —— 分组列表：自建相册（含「新建相册」动作行）/ 文件夹相册（相机 + 目录相册）
    · addto_empty   —— 空态（没有可添加的照片时）

  颜色一律走 styles_album.xml 与公共样式，布局里不写颜色值。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addto_root"
    style="@style/Widget.Gallery.RootSurface"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/addto_toolbar"
        style="@style/Widget.Gallery.Toolbar.Surface"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/addto_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/addto_title" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/addto_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        <TextView
            android:id="@+id/addto_empty"
            style="@style/TextAppearance.Gallery.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/addto_empty_media"
            android:textSize="14sp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>
