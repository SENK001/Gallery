<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/viewer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Widget.Gallery.RootSurface">

    <com.senk.gallery.ui.gl.GlImageViewer
        android:id="@+id/image_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:minHeight="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:subtitleTextColor="@color/gallery_text_secondary"
        style="@style/Widget.Gallery.Toolbar.Surface" />

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp"
        android:paddingBottom="10dp"
        style="@style/Widget.Gallery.ViewerBar">

        <ImageButton
            android:id="@+id/action_share"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/gallery_share"
            android:src="@drawable/ic_share"
            app:tint="@color/gallery_icon_on_surface" />

        <ImageButton
            android:id="@+id/action_favorite"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/gallery_favorite"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/gallery_icon_on_surface" />

        <ImageButton
            android:id="@+id/action_info"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:contentDescription="@string/gallery_info"
            android:src="@drawable/ic_info"
            app:tint="@color/gallery_icon_on_surface" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/details_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_viewer_sheet"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="invisible">

        <FrameLayout
            android:id="@+id/sheet_handle"
            android:layout_width="match_parent"
            android:layout_height="28dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_viewer_sheet_handle" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/sheet_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/sheet_basic_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    style="@style/TextAppearance.Gallery.Body"
                    android:textSize="14sp" />

                <FrameLayout
                    android:id="@+id/sheet_map_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_viewer_map_card"
                    android:clipToOutline="true"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:id="@+id/sheet_map_container"
                            android:layout_width="match_parent"
                            android:layout_height="160dp" />

                        <TextView
                            android:id="@+id/sheet_map_address"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:padding="12dp"
                            style="@style/TextAppearance.Gallery.Body"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <View
                        android:id="@+id/sheet_map_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true" />
                </FrameLayout>

                <TextView
                    android:id="@+id/sheet_exif_info"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:lineSpacingExtra="4dp"
                    style="@style/TextAppearance.Gallery.Body"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</FrameLayout>
