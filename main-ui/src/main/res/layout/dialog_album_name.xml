<?xml version="1.0" encoding="utf-8"?>
<!--
  相册名称输入对话框（新建相册 / 重命名共用）。

  输入框 hint 与 maxLength 与 CustomAlbumStore.MAX_NAME_LENGTH（40）保持一致；
  错误提示由 AlbumNameDialog 通过 TextInputLayout.setError 显示在此框下方。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/album_name_input_layout"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/album_name_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/album_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLength="40"
            android:maxLines="1"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
