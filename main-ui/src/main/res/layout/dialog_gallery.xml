<?xml version="1.0" encoding="utf-8"?>
<!--
  应用统一自定义对话框（`GalleryDialog`）的根布局：圆角卡片 + 标题 + 正文 + 内容区 + 按钮行。

  结构约定：
  - 标题/正文/内容区/按钮行都可能不存在（按 Builder 配置显示），因此初始 visibility=gone；
  - 按钮行：左「取消」（中性 tonal）、右「确认」（品牌主色实心）；只有确认时铺满整行；
  - 卡片圆角 28dp 与隐私页按钮/卡片观感一致；颜色全部引用 style/色板，不写死。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dialog_gallery_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_gallery_dialog"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:id="@+id/dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        style="@style/TextAppearance.Gallery.DialogTitle" />

    <TextView
        android:id="@+id/dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        style="@style/TextAppearance.Gallery.DialogBody" />

    <FrameLayout
        android:id="@+id/dialog_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/dialog_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_negative"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:visibility="gone"
            style="@style/Widget.Gallery.DialogButton.Secondary" />

        <Space
            android:id="@+id/dialog_button_spacer"
            android:layout_width="12dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dialog_positive"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:visibility="gone"
            style="@style/Widget.Gallery.DialogButton.Primary" />

    </LinearLayout>

</LinearLayout>
