<?xml version="1.0" encoding="utf-8"?>
<!--
  「添加到」页的目标行：可点选择目标的相册（自建相册 / 相机 / 文件夹相册）。

  封面（左）+ 名称 + 副标题（数量 + 「复制到该文件夹」/「加入应用内相册」语义）。
  颜色全部经 styles_album.xml 引用色板，布局里不写颜色值。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/addto_album_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/addto_album_cover"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Gallery.Cover" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/addto_album_name"
            style="@style/Widget.Gallery.AddToName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/addto_album_subtitle"
            style="@style/Widget.Gallery.AddToSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
