<?xml version="1.0" encoding="utf-8"?>
<!--
  相册页最底部的「最近删除」入口行（更多相册之后）。
  按产品要求：**不放封面**，只用图标 + 名称 + 条数；点击进入最近删除页。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/album_trash_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/album_trash_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_delete"
        style="@style/Widget.Gallery.SelectionActionIcon" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/album_trash_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            style="@style/Widget.Gallery.AlbumName"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/album_trash_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            style="@style/Widget.Gallery.AlbumCount"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
