<?xml version="1.0" encoding="utf-8"?>
<!--
  多选底部动作栏的内容（由 SelectionActionBar 以 merge 方式 inflate 进自身）。
  每个动作固定 72dp 宽：4 个动作 + 胶囊左右各 8dp 内边距 = 304dp（与 SelectionActionBar 的宽度动画常量一致）。

  每个动作 = 图标 + 中文文字，容器可点击/可聚焦，contentDescription 直接用文字，
  保证 TalkBack 能逐项读出「分享 / 收藏 / 添加到 / 删除」。
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/selection_action_share"
        android:layout_width="72dp"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/gallery_share"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/selection_icon_share"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_share"
            style="@style/Widget.Gallery.SelectionActionIcon" />

        <TextView
            android:id="@+id/selection_label_share"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/gallery_share"
            style="@style/Widget.Gallery.SelectionActionLabel" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selection_action_favorite"
        android:layout_width="72dp"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/gallery_favorite"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/selection_icon_favorite"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_favorite_border"
            style="@style/Widget.Gallery.SelectionActionIcon" />

        <TextView
            android:id="@+id/selection_label_favorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/gallery_favorite"
            style="@style/Widget.Gallery.SelectionActionLabel" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selection_action_add_to"
        android:layout_width="72dp"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/selection_add_to_album"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/selection_icon_add_to"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_library_add"
            style="@style/Widget.Gallery.SelectionActionIcon" />

        <TextView
            android:id="@+id/selection_label_add_to"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/selection_add_to_album"
            style="@style/Widget.Gallery.SelectionActionLabel" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/selection_action_delete"
        android:layout_width="72dp"
        android:layout_height="64dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:contentDescription="@string/selection_delete"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/selection_icon_delete"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_delete"
            style="@style/Widget.Gallery.SelectionActionIcon" />

        <TextView
            android:id="@+id/selection_label_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/selection_delete"
            style="@style/Widget.Gallery.SelectionActionLabel" />
    </LinearLayout>

</merge>
