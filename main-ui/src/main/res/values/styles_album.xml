<?xml version="1.0" encoding="utf-8"?>
<!--
  自建相册 + 「添加到」页专用样式。

  遵循 docs/theme.md：布局里不直接写颜色，颜色只在 colors.xml（含 values-night）定义，
  本文件负责把语义色板挂到这批新控件上。
-->
<resources>

    <!-- 动作行图标（新建相册 / 添加到等）：跟随主题的前景图标色 -->
    <style name="Widget.Gallery.AddToIcon">
        <item name="android:tint">@color/gallery_icon_on_surface</item>
    </style>

    <!-- 目标/动作行主文案 -->
    <style name="Widget.Gallery.AddToName">
        <item name="android:textColor">@color/gallery_text_primary</item>
    </style>

    <!-- 目标行副标题（数量 + 复制/加入语义） -->
    <style name="Widget.Gallery.AddToSubtitle">
        <item name="android:textColor">@color/gallery_text_secondary</item>
    </style>

    <!-- 分节内的提示文案（如「还没有自建相册」） -->
    <style name="Widget.Gallery.AddToCaption">
        <item name="android:textColor">@color/gallery_text_secondary</item>
    </style>

</resources>
