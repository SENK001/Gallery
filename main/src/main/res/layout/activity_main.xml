<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/Widget.Gallery.ChromeSurface"
    tools:context=".MainActivity">

    <!--
      pager 铺满整个窗口，toolbar / 胶囊导航作为覆盖层叠在其上——
      这样「照片」页的宫格缩略图才能画到屏幕最底边（含系统导航栏区域）。
      「相册」页不要这个效果，由 MainActivity.applyChromeForPage() 给 root 加回
      「状态栏 + 标题栏」内边距来还原成原来的占位式布局。
      toolbar 使用黑色渐变遮罩（bg_toolbar_scrim），随宫格滚动淡入淡出，
      见 MainActivity.onGridScrolled()。
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/permission_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/Widget.Gallery.PermissionOverlay"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/permission_title"
                android:textSize="17sp"
                style="@style/TextAppearance.Gallery.PermissionTitle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/permission_message"
                android:textSize="13sp"
                style="@style/TextAppearance.Gallery.PermissionMessage" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permission_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/permission_grant" />

        </LinearLayout>

    </FrameLayout>

    <!--
      状态栏底条：用主题底色 gallery_chrome_surface（深色模式下自动变深），
      让状态栏区域与标题栏的底色一致。高度由 MainActivity 按 insets 设置。
    -->
    <View
        android:id="@+id/status_bar_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        style="@style/Widget.Gallery.ChromeSurface" />

    <!--
      标题栏。高度用 actionBarSize，状态栏高度用 **marginTop** 让开
      （不能改 paddingTop：那会把 toolbar 撑高成 statusBar+actionBarSize，
      标题在整块里居中后就落到状态栏与内容交界处，看着像被截断——真机实测踩过）。

      **背景保持透明，靠父容器（@id/main）的 gallery_chrome_surface 显示**：
        · 静止 → 透出主题底色（浅色模式为白、深色模式自动变深）+ 深色标题
        · 上划 → 交给 toolbar_scrim 渐变遮罩（标题转白），缩略图从下方滚过
      不写死不透明背景，是为了深色模式能跟随主题，且上划时不会有白底残留。
    -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:title="@string/app_name"
        style="@style/Widget.Gallery.Toolbar" />

    <!--
      上划时的黑色渐变遮罩（visible=gone，由 MainActivity 控制）。
      覆盖范围是「状态栏 + 标题栏」，用代码画的 LinearGradient 填充，见 MainActivity.buildScrim()。
    -->
    <View
        android:id="@+id/toolbar_scrim"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_nav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        style="@style/Widget.Gallery.NavCard">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <FrameLayout
                android:id="@+id/nav_photos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_nav_item"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:minWidth="92dp"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/gallery_tab_photos"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_tab_photos"
                        style="@style/Widget.Gallery.NavIcon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:duplicateParentState="true"
                        android:text="@string/gallery_tab_photos"
                        android:textSize="11sp"
                        style="@style/Widget.Gallery.NavLabel" />

                </LinearLayout>

            </FrameLayout>

            <FrameLayout
                android:id="@+id/nav_albums"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_nav_item"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:minWidth="92dp"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/gallery_tab_albums"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_tab_albums"
                        style="@style/Widget.Gallery.NavIcon" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:duplicateParentState="true"
                        android:text="@string/gallery_tab_albums"
                        android:textSize="11sp"
                        style="@style/Widget.Gallery.NavLabel" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
