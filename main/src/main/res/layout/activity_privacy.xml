<?xml version="1.0" encoding="utf-8"?>
<!--
  首次启动隐私政策同意页（全屏页，非对话框）。
  布局与间距对齐系统应用（MIUI/HyperOS）首启隐私同意页：
  白底全屏 + 顶部居中应用标识块 + 标题 + 欢迎说明 + 权限条目列表 +
  底部「隐私」标识与分割线 + 同意声明（含可点链接）+ 底部「退出 / 同意」按钮。
  实测参考某 Android 16 真机（屏幕尺寸与密度已脱敏）：标题居中 y587-664；正文左右边距 102px≈36dp；
  权威条目图标底 88x88px≈31dp 圆角 14dp；按钮高 159px≈56dp、圆角 21dp；
  左按钮边距 89px≈31dp、右按钮右边距 89px；两按钮间距 38px≈13dp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/privacy_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical"
    android:paddingHorizontal="36dp">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 应用标识块 -->
            <View
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_privacy_app_icon" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/privacy_text_primary"
                android:textSize="19sp" />

            <!-- 欢迎说明 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:letterSpacing="0.01"
                android:lineSpacingExtra="10dp"
                android:text="@string/privacy_welcome"
                android:textColor="@color/privacy_text_primary"
                android:textSize="17sp" />

            <!-- 权限条目：媒体访问 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_privacy_perm_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/privacy_perm_media_title"
                        android:src="@drawable/ic_privacy_perm_media" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_perm_media_title"
                        android:textColor="@color/privacy_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_perm_media_desc"
                        android:textColor="@color/privacy_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 权限条目：拍摄地点 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_privacy_perm_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/privacy_perm_location_title"
                        android:src="@drawable/ic_privacy_perm_location" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_perm_location_title"
                        android:textColor="@color/privacy_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_perm_location_desc"
                        android:textColor="@color/privacy_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 权限条目：收藏写回 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_privacy_perm_icon">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/privacy_perm_favorite_title"
                        android:src="@drawable/ic_privacy_perm_favorite" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/privacy_perm_favorite_title"
                        android:textColor="@color/privacy_text_primary"
                        android:textSize="17sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/privacy_perm_favorite_desc"
                        android:textColor="@color/privacy_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 底部：隐私标识 + 分割线 + 同意声明 + 按钮 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:text="@string/privacy_badge"
        android:textColor="@color/privacy_text_primary"
        android:textSize="17sp"
        app:drawableStartCompat="@drawable/ic_privacy_badge_shield"
        app:drawableTint="@color/privacy_button_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#1F000000" />

        <TextView
            android:id="@+id/privacy_statement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/privacy_statement"
            android:textColor="@color/privacy_text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/privacy_disagree"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/privacy_disagree"
                android:textColor="@color/privacy_text_primary"
                android:textSize="18sp"
                app:backgroundTint="@color/privacy_button_neutral"
                app:cornerRadius="28dp" />

            <Space
                android:layout_width="13dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/privacy_agree"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/privacy_agree"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/privacy_button_primary"
                app:cornerRadius="28dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
