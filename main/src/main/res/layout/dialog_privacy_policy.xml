<?xml version="1.0" encoding="utf-8"?>
<!--
  隐私政策正文（`GalleryDialog` 的内容区）：只放可滚动正文，标题/关闭按钮由统一对话框提供。
  高度由 `PrivacyActivity` 按屏幕比例设置，保证长文本在弹窗内滚动。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/privacy_policy_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fadeScrollbars="false"
    android:scrollbarStyle="insideInset"
    android:scrollbars="vertical">

    <TextView
        android:id="@+id/privacy_policy_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="6dp"
        android:text="@string/privacy_policy_body"
        android:textIsSelectable="true"
        style="@style/TextAppearance.Gallery.PrivacyBody"
        android:textSize="15sp" />

</ScrollView>
