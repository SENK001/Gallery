<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Gallery" parent="Theme.Material3.Light.NoActionBar">
    </style>

    <style name="Theme.Gallery" parent="Base.Theme.Gallery" />

    <!--
      隐私政策同意页主题：全屏白底页（非对话框），不设遮罩、不设卡片。
      窗口背景设为透明，白色只由布局根节点绘制一次，避免主题背景与布局背景
      重复绘制（lint Overdraw）；状态栏保持可见并使用深色图标，与系统应用首启页一致。
    -->
    <style name="Theme.Gallery.Privacy" parent="Theme.Gallery">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!--
      查看器主题：转场完全由应用内覆盖层动画完成（缩略图展开/收回），
      必须关闭系统 Activity 窗口动画，否则退出时覆盖层缩回后又叠一层系统淡出/缩放动画。
      API 34+ 另在代码里调 overrideActivityTransition(CLOSE, 0, 0)。
      使用方在 main-ui 的 AndroidManifest（合并后可见），lint 跨模块统计不到该引用，显式忽略。
    -->
    <style name="Theme.Gallery.Viewer" parent="Theme.Gallery" tools:ignore="UnusedResources">
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>